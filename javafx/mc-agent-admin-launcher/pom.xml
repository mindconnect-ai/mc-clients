<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.mindconnect</groupId>
        <artifactId>mc-clients-javafx</artifactId>
        <version>1.3.0</version>
    </parent>

    <artifactId>mc-agent-admin-launcher</artifactId>
    <name>mc-agent-admin-launcher</name>
    <packaging>jar</packaging>
    <description>Desktop launcher for the agent server — download, configure, start, stop</description>

    <dependencies>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-server-control-fx</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-agent-remote-connector</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-semantic-ui-javafx</artifactId>
            <version>${semantic-ui.version}</version>
        </dependency>
        <!-- Only for the screenshot test hook (FX image → PNG). -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>21.0.4</version>
        </dependency>
    </dependencies>

    <properties>
        <!-- The installer reports the Maven version to the OS. That is why the
             Maven version is a release version and never a -SNAPSHOT: jpackage
             rejects -SNAPSHOT, and macOS requires the first number to be >= 1.
             release.sh sets it, to the version being tagged. -->
        <app.version>${project.version}</app.version>
        <jpackage.type>APP_IMAGE</jpackage.type>
        <jpackage.icon>${project.basedir}/packaging/icon.icns</jpackage.icon>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>ai.mindconnect.agent.adminlauncher.LauncherMain</mainClass>
                </configuration>
            </plugin>
            <!-- One double-clickable jar with everything inside. The JavaFX
                 natives in it are platform-specific, so the jar runs on the
                 platform it was built on (mac-aarch64 on an Apple-silicon
                 build machine, and so on). LauncherMain being a plain main
                 class — not an Application — is what makes JavaFX accept a
                 fat-jar launch at all. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ai.mindconnect.agent.adminlauncher.LauncherMain</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Native installer with a bundled Java runtime:
                 mvn -Pinstaller package jpackage:jpackage -Djpackage.type=DMG|MSI|DEB
                 Must run on the target OS — CI builds one per platform. -->
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>installer</id>
            <build>
                <plugins>
                    <!-- jpackage copies its whole input directory into the app,
                         so it gets a directory holding exactly one file: the fat jar. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>stage-jpackage-input</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/jpackage-input"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}-all.jar"
                                              todir="${project.build.directory}/jpackage-input"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.5</version>
                        <configuration>
                            <name>Mindconnect Admin Launcher</name>
                            <vendor>Mindconnect</vendor>
                            <icon>${jpackage.icon}</icon>
                            <appVersion>${app.version}</appVersion>
                            <type>${jpackage.type}</type>
                            <input>${project.build.directory}/jpackage-input</input>
                            <mainJar>${project.build.finalName}-all.jar</mainJar>
                            <destination>${project.build.directory}/installer</destination>
                            <!-- jpackage's default jlink options include
                                 &#45;&#45;strip-native-commands, which removes bin/java from
                                 the bundled runtime. The launcher needs exactly that
                                 binary to start the server as a child JVM, so we
                                 override the list without the strip. -->
                            <jLinkOptions>
                                <option>--strip-debug</option>
                                <option>--no-man-pages</option>
                                <option>--no-header-files</option>
                            </jLinkOptions>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
